{
  "$schema": "https://raw.githubusercontent.com/anthropics/claude-code/main/.mcp.schema.json",
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "expo": {
      "type": "http",
      "url": "https://mcp.expo.dev/mcp"
    },
    "moai": {
      "args": [
        "mcp-server"
      ],
      "command": "moai"
    }
  },
  "staggeredStartup": {
    "connectionTimeout": 15000,
    "delayMs": 500,
    "enabled": true
  }
}